{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node --max_old_space_size=1536 ./node_modules/vite/bin/vite.js build",
        "dev": "vite",
        "docs:index": "node scripts/generate-doc-index.mjs",
        "docs:index:check": "node scripts/generate-doc-index.mjs --check",
        "qa:build": "npm run build",
        "qa:branding-colors": "node scripts/check-company-branding-colors.mjs",
        "qa:capacity-runner": "node --test tests/Node/P0006CapacityRunnerTest.mjs",
        "qa:node": "node --test tests/Node/*.mjs",
        "qa:frontend-budgets": "node scripts/check-frontend-budgets.mjs",
        "qa:frontend-budgets:measure": "node scripts/check-frontend-budgets.mjs --measure",
        "qa:e2e": "npm run qa:build && playwright test",
        "qa:e2e:install": "playwright install chromium"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/forms": "^0.5.3",
        "@types/dropzone": "^5.7.9",
        "@vitejs/plugin-vue": "^5.0.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.18.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.0",
        "postcss": "^8.5.18",
        "tailwindcss": "^3.2.1",
        "vite": "^6.4.3",
        "vue": "^3.4.0"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.15",
        "@fullcalendar/daygrid": "^6.1.15",
        "@fullcalendar/interaction": "^6.1.15",
        "@fullcalendar/timegrid": "^6.1.15",
        "@fullcalendar/vue3": "^6.1.15",
        "@preline/datatable": "^2.5.2",
        "@preline/input-number": "^2.5.2",
        "apexcharts": "^4.3.0",
        "cally": "^0.7.2",
        "clipboard": "^2.0.11",
        "datatables.net-dt": "^2.2.1",
        "dayjs": "^1.11.13",
        "dropzone": "^6.0.0-beta.2",
        "lucide-vue-next": "^0.577.0",
        "preline": "^2.7.0",
        "vue-i18n": "^11.2.7",
        "vuedraggable": "^4.1.0"
    }
