<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-config.php"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/phpunit-events.php"/>
        <env name="APP_PACKAGES_CACHE" value="bootstrap/cache/phpunit-packages.php"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/phpunit-routes.php"/>
        <env name="APP_SERVICES_CACHE" value="bootstrap/cache/phpunit-services.php"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="EXPECTED_TEST_DATABASE_DRIVER" value="sqlite"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <env name="DB_QUEUE_RETRY_AFTER" value="1200"/>
        <env name="BEANSTALKD_QUEUE_RETRY_AFTER" value="1200"/>
        <env name="REDIS_QUEUE_RETRY_AFTER" value="1200"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="TWILIO_SID" value="" force="true"/>
        <env name="TWILIO_AUTH_TOKEN" value="" force="true"/>
        <env name="TWILIO_FROM" value="" force="true"/>
        <env name="TWILIO_WHATSAPP_FROM" value="" force="true"/>
    </php>
</phpunit>
